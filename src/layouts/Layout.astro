---
// Base layout — al-Nizam brand (gold on night). `theme` selects the surface:
//   'dark'  (default) — brand/marketing surfaces (gold on night)
//   'light' — reading surfaces (ink on paper) per the brand's dark-first + warm-reading model
const { title, description, theme = 'dark' } = Astro.props;
const htmlClass = theme === 'light' ? 'theme-light' : '';
// Copyright year computed at build time — never goes stale.
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en" class={htmlClass}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description ?? 'al-Nizam — an operating layer between you and AI that holds continuity, governance, and accountability structurally.'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? 'al-Nizam — an operating layer for AI-powered work.'} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://al-nizam.ai${Astro.url.pathname}`} />
    <title>{title}</title>
    <link rel="canonical" href={`https://al-nizam.ai${Astro.url.pathname}`} />
    <link rel="alternate" type="application/rss+xml" title="al-Nizam Leadership" href="/leadership/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global>
      :root {
        /* al-Nizam brand — gold on night (see brand/BRAND-GUIDE.html) */
        --color-text: #F6F3EC;
        --color-text-muted: #8A93A3;
        --color-accent: #C9A24B;
        --color-accent-hover: #E6C66E;
        --color-bg: #0E1220;
        --color-border: rgba(255, 255, 255, 0.10);
        --surface-subtle: rgba(255, 255, 255, 0.08);
        --font-body: 'Georgia', 'Cambria', serif;
        --font-mono: 'SF Mono', 'Monaco', 'Consolas', monospace;
        --max-width-prose: 38rem;
        --max-width-page: 56rem;
      }

      /* Light reading surface — ink on paper. Accent deepened for AA contrast on paper. */
      html.theme-light {
        --color-text: #14171C;
        --color-text-muted: #6B7280;
        --color-accent: #8C6A1F;
        --color-accent-hover: #C9A24B;
        --color-bg: #F6F3EC;
        --color-border: rgba(0, 0, 0, 0.12);
        --surface-subtle: rgba(0, 0, 0, 0.06);
      }

      * {
        box-sizing: border-box;
      }

      html {
        font-family: var(--font-body);
        font-size: 18px;
        line-height: 1.65;
        color: var(--color-text);
        background: var(--color-bg);
        /* Full-bleed bands use 100vw, which is wider than the content area by the
           scrollbar's width. Clip that sliver so it never opens a horizontal
           scrollbar (which is what shifted the centered hero left on wide windows). */
        overflow-x: hidden;
      }

      body {
        margin: 0;
        padding: 0;
      }

      main {
        max-width: var(--max-width-page);
        margin: 0 auto;
        padding: 2.5rem 1.5rem;
      }

      article {
        max-width: var(--max-width-prose);
        margin: 0 auto;
      }

      /* Header is a fixed dark brand band on EVERY page (theme-independent),
         full-width, wrapping a centered inner container. */
      header.site-header {
        background: #0E1220;
        border-bottom: 1px solid rgba(255, 255, 255, 0.10);
      }

      header.site-header .header-inner {
        max-width: var(--max-width-page);
        margin: 0 auto;
        padding: 1.25rem 1.5rem;
        display: flex;
        align-items: center;
      }

      header.site-header a.logo {
        font-size: 1.25rem;
        font-weight: bold;
        text-decoration: none;
        color: #F6F3EC;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
      }

      header.site-header a.logo .logo-mark {
        width: 1.5rem;
        height: 1.5rem;
        color: #C9A24B;
        flex: none;
      }

      header.site-header nav {
        margin-left: 2rem;
      }

      header.site-header nav a {
        margin-right: 1.5rem;
        color: #8A93A3;
        text-decoration: none;
        font-size: 0.95rem;
      }

      header.site-header nav a:hover {
        color: #C9A24B;
      }

      h1 {
        font-size: 2.25rem;
        line-height: 1.2;
        margin-top: 0;
      }

      h2 {
        font-size: 1.5rem;
        margin-top: 2.5rem;
        line-height: 1.3;
      }

      h3 {
        font-size: 1.2rem;
        margin-top: 2rem;
      }

      a {
        color: var(--color-accent);
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      a:hover {
        color: var(--color-accent-hover);
      }

      blockquote {
        border-left: 3px solid var(--color-accent);
        margin: 1.5rem 0;
        padding-left: 1.25rem;
        color: var(--color-text-muted);
        font-style: italic;
      }

      code {
        font-family: var(--font-mono);
        font-size: 0.9em;
        background: var(--surface-subtle);
        padding: 0.1rem 0.3rem;
        border-radius: 3px;
      }

      pre {
        background: #1a1a1a;
        color: #f0f0f0;
        padding: 1rem;
        border-radius: 4px;
        overflow-x: auto;
      }

      pre code {
        background: transparent;
        padding: 0;
        color: inherit;
      }

      hr {
        border: 0;
        border-top: 1px solid var(--color-border);
        margin: 3rem 0;
      }

      .author-bio {
        max-width: var(--max-width-prose);
        margin: 3rem auto 0;
        padding-top: 2rem;
        border-top: 1px solid var(--color-border);
        font-size: 0.95rem;
        color: var(--color-text-muted);
      }

      .author-bio strong {
        color: var(--color-text);
      }

      .article-lineage {
        max-width: var(--max-width-prose);
        margin: 3rem auto 0;
        padding-top: 2rem;
        border-top: 1px solid var(--color-border);
        font-size: 0.875rem;
        color: var(--color-text-muted);
      }

      .article-lineage h3 {
        font-size: 0.95rem;
        margin: 0 0 0.75rem;
        color: var(--color-text);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: bold;
      }

      .article-lineage ul {
        list-style: none;
        padding-left: 0;
        margin: 0;
      }

      .article-lineage li {
        margin-bottom: 0.5rem;
        line-height: 1.5;
      }

      .article-lineage strong {
        color: var(--color-text);
      }

      /* Footer mirrors the header as a fixed dark brand band on every page. */
      footer.site-footer {
        background: #0E1220;
        border-top: 1px solid rgba(255, 255, 255, 0.10);
        color: #8A93A3;
        font-size: 0.9rem;
        text-align: center;
        margin-top: 4rem;
      }

      footer.site-footer .footer-inner {
        max-width: var(--max-width-page);
        margin: 0 auto;
        padding: 2rem 1.5rem;
      }

      footer.site-footer .footer-nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem 1.5rem;
        margin-bottom: 1.1rem;
      }

      footer.site-footer .footer-nav a {
        color: #8A93A3;
        text-decoration: none;
        font-size: 0.88rem;
      }

      footer.site-footer .footer-nav a:hover {
        color: #C9A24B;
      }

      footer.site-footer .footer-tagline {
        margin: 0 0 0.4rem;
      }

      footer.site-footer .footer-copy {
        margin: 0;
        font-size: 0.82rem;
        color: #6B7280;
      }

      footer.site-footer a {
        color: #8A93A3;
      }

      .lead {
        font-size: 1.15rem;
        color: var(--color-text-muted);
        margin-bottom: 2rem;
      }

      .article-list {
        list-style: none;
        padding: 0;
      }

      .article-list li {
        margin-bottom: 1.5rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--color-border);
      }

      .article-list h3 {
        margin: 0 0 0.25rem;
        font-size: 1.15rem;
      }

      .article-list .meta {
        color: var(--color-text-muted);
        font-size: 0.9rem;
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="logo" aria-label="al-Nizam home">
          <svg class="logo-mark" viewBox="56.5 66.7 90 90" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path fill="currentColor" d="m 66.225562,102.91471 a 33.489777,21.861039 35.771948 0 0 30.000862,26.2724 33.489777,21.861039 35.771948 0 0 28.199956,-16.23224 33.489777,21.861039 35.771948 0 0 -23.48847,-30.296333 39.626193,25.86669 35.771943 0 1 35.98779,39.271113 39.626193,25.86669 35.771943 0 1 -33.36723,19.20667 39.626193,25.86669 35.771943 0 1 -37.332908,-38.22161 z"/>
            <ellipse fill="currentColor" cx="80.580521" cy="88.287498" rx="6.3862953" ry="6.0728579"/>
          </svg>
          <span>al-Nizam</span>
        </a>
        <nav>
          <a href="/leadership/">Leadership</a>
          <a href="/about">About</a>
          <a href="/founder">Founder</a>
          <a href="/confidant">Confidant</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <nav class="footer-nav" aria-label="Footer">
          <a href="/about">About</a>
          <a href="/leadership/">Leadership</a>
          <a href="/founder">Founder</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href="/contact">Contact</a>
        </nav>
        <p class="footer-tagline">al-Nizam — an operating layer between operator and AI.</p>
        <p class="footer-copy">© {year} al-Nizam. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
