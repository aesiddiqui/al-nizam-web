---
// Base layout — al-Nizam brand (gold on night). `theme` selects the surface:
//   'dark'  (default) — brand/marketing surfaces (gold on night)
//   'light' — reading surfaces (ink on paper) per the brand's dark-first + warm-reading model
const { title, description, theme = 'dark', article } = Astro.props;
const htmlClass = theme === 'light' ? 'theme-light' : '';
// Copyright year computed at build time — never goes stale.
const year = new Date().getFullYear();

// --- SEO: canonical URL, social card, structured data ---
const SITE = 'https://al-nizam.ai';
const pageUrl = `${SITE}${Astro.url.pathname}`;
const ogImage = `${SITE}/og-image.png`;
const metaDesc = description ?? 'al-Nizam — an operating layer between you and AI that holds continuity, governance, and accountability structurally.';

// Organization + WebSite entity — emitted site-wide so search engines resolve al-Nizam
// as an entity. Article (BlogPosting) is emitted only when a page passes `article`.
const orgLd = {
  '@context': 'https://schema.org', '@type': 'Organization',
  name: 'al-Nizam', url: SITE, logo: `${SITE}/app-icon-512.png`,
  description: 'An operating layer between you and AI — continuity, governance, and accountability held structurally.',
  founder: { '@type': 'Person', name: 'Ebadullah Siddiqui' },
};
const siteLd = {
  '@context': 'https://schema.org', '@type': 'WebSite', name: 'al-Nizam', url: SITE,
};
const articleLd = article ? {
  '@context': 'https://schema.org', '@type': 'BlogPosting',
  headline: article.title, description: article.description ?? metaDesc,
  datePublished: article.datePublished, dateModified: article.dateModified ?? article.datePublished,
  url: pageUrl, image: ogImage,
  author: { '@type': 'Person', name: 'Ebadullah Siddiqui' },
  publisher: { '@type': 'Organization', name: 'al-Nizam', logo: { '@type': 'ImageObject', url: `${SITE}/app-icon-512.png` } },
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
} : null;

// Self-hosted brand fonts (canonical): Spectral = display/headings + wordmark,
// Hanken Grotesk = body/UI ("carries the work"). Self-hosted (no third-party
// request) per al-Nizam's ownership ethos.
import '@fontsource-variable/hanken-grotesk/index.css';
import '@fontsource/spectral/latin-400.css';
import '@fontsource/spectral/latin-500.css';
import '@fontsource/spectral/latin-600.css';
import '@fontsource/spectral/latin-700.css';
---

<!DOCTYPE html>
<html lang="en" class={htmlClass}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDesc} />
    <meta name="theme-color" content="#14171C" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="al-Nizam" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="al-Nizam — an operating layer between you and AI" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" type="application/rss+xml" title="al-Nizam Leadership" href="/leadership/rss.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
    {articleLd && <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-180.png" />
    <style is:global>
      :root {
        /* al-Nizam canonical brand — amber on warm ink (brand/canonical-2026-07-04). */

        /* Brand-CONSTANT tokens — the canonical palette. These do NOT flip with
           theme (unlike the --color-* semantic tokens below). Figures, tiles, and
           night bands reference these, so changing a brand color is one edit here
           instead of a hunt across files. Single source of truth for the palette. */
        --brand-night: #14171C;            /* canonical ink / night ground */
        --brand-paper: #F6F3EC;            /* canonical paper */
        --brand-paper-raised: #FBF8F1;     /* figure / tile surface */
        --brand-paper-sunk: #F3EEE1;       /* emphasized tile · table header */
        --brand-gold: #C49A3F;             /* canonical gold accent */
        --brand-star: #E6C66E;             /* brighter gold — hover / highlight */
        --brand-gold-ink: #8A6414;         /* gold on paper — tags, kickers */
        --brand-gold-ink-strong: #7E5C18;  /* accent on paper (AA-safe) */
        --brand-red: #A24B3B;              /* semantic failure on paper */
        --brand-red-bright: #E0796B;       /* semantic failure on night (tool output) */
        --brand-muted: #8A93A3;            /* muted text on night */
        --brand-muted-paper: #6B7280;      /* muted text on paper */

        /* Theme-relative semantic tokens — these DO flip in html.theme-light below. */
        --color-text: #F6F3EC;
        --color-text-muted: #8A93A3;
        --color-accent: #C49A3F;
        --color-accent-hover: #E6C66E;
        --color-bg: #14171C;
        --color-border: rgba(255, 255, 255, 0.10);
        --surface-subtle: rgba(255, 255, 255, 0.08);
        --card-surface: rgba(255, 255, 255, 0.03);   /* card fill on night (flips in theme-light) */
        --font-display: 'Spectral', Georgia, 'Times New Roman', serif;
        --font-body: 'Hanken Grotesk Variable', system-ui, -apple-system, 'Segoe UI', sans-serif;
        --font-mono: 'SF Mono', 'Monaco', 'Consolas', monospace;
        --max-width-prose: 48rem;
        --max-width-page: 56rem;
      }

      /* Light reading surface — ink on paper. Accent deepened for AA contrast on paper:
         #7E5C18 = 5.52:1 (comfortable AA); hover DARKENS (#6E5013, ~7:1) rather than
         brightening — the canonical amber #C49A3F is only 2.36:1 on paper, so a
         brighten-on-hover washes out. Emphasis on paper reads as "more ink", not "more gold". */
      html.theme-light {
        --color-text: #14171C;
        --color-text-muted: #6B7280;
        --color-accent: #7E5C18;
        --color-accent-hover: #6E5013;
        --color-bg: #F6F3EC;
        --color-border: rgba(0, 0, 0, 0.12);
        --surface-subtle: rgba(0, 0, 0, 0.06);
        --card-surface: var(--brand-paper-raised);   /* card fill on paper reading surfaces */
      }

      * {
        box-sizing: border-box;
      }

      html {
        font-family: var(--font-body);
        font-size: 18px;
        line-height: 1.65;
        color: var(--color-text);
        background: var(--color-bg);
        /* Full-bleed bands use 100vw, which is wider than the content area by the
           scrollbar's width. Clip that sliver so it never opens a horizontal
           scrollbar (which is what shifted the centered hero left on wide windows).
           `clip` (not `hidden`) clips WITHOUT creating a scroll container, so the
           sticky header below keeps working. */
        overflow-x: clip;
      }

      body {
        margin: 0;
        padding: 0;
      }

      main {
        max-width: var(--max-width-page);
        margin: 0 auto;
        padding: 2.5rem 1.5rem;
      }

      article {
        max-width: var(--max-width-prose);
        margin: 0 auto;
      }

      /* Header is a fixed dark brand band on EVERY page (theme-independent),
         full-width, wrapping a centered inner container. */
      header.site-header {
        background: var(--brand-night);
        border-bottom: 1px solid rgba(255, 255, 255, 0.10);
        /* Sticky — stays pinned at the top through the scroll. */
        position: sticky;
        top: 0;
        z-index: 100;
        transition: box-shadow 0.25s ease, border-color 0.25s ease;
      }

      /* Condense on scroll — toggled by a class once the page leaves the top.
         A subtle shadow + gold hairline lifts the bar above the content. */
      header.site-header.scrolled {
        box-shadow: 0 6px 24px rgba(0, 0, 0, 0.45);
        border-bottom-color: rgba(196, 154, 63, 0.28);
      }

      header.site-header .header-inner {
        max-width: var(--max-width-page);
        margin: 0 auto;
        padding: 1.25rem 1.5rem;
        display: flex;
        align-items: center;
        transition: padding 0.25s ease;
      }

      /* Smaller padding + logo once scrolled — the size change the bar makes. */
      header.site-header.scrolled .header-inner {
        padding: 0.65rem 1.5rem;
      }

      header.site-header a.logo {
        transition: font-size 0.25s ease;
      }

      header.site-header.scrolled a.logo {
        font-size: 1.1rem;
      }

      header.site-header a.logo .logo-mark {
        transition: width 0.25s ease, height 0.25s ease;
      }

      header.site-header.scrolled a.logo .logo-mark {
        width: 1.25rem;
        height: 1.25rem;
      }

      header.site-header a.logo {
        font-family: var(--font-display);
        font-size: 1.35rem;
        font-weight: 600;
        letter-spacing: 0.01em;
        text-decoration: none;
        color: var(--brand-paper);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
      }

      /* Two-color canonical mark: the crescent inherits the surface color via
         `currentColor` (paper on this dark header); the gold dot is a fixed fill in
         the SVG. Gold stays scarce — the focal accent, not the whole mark. */
      header.site-header a.logo .logo-mark {
        width: 1.6rem;
        height: 1.6rem;
        color: var(--brand-paper);
        flex: none;
      }

      header.site-header nav {
        margin-left: 2rem;
      }

      header.site-header nav a {
        margin-right: 1.5rem;
        color: var(--brand-muted);
        text-decoration: none;
        font-size: 0.95rem;
        position: relative;
        transition: color 0.2s ease;
      }
      /* Animated gold underline that wipes in from the left on hover/focus. */
      header.site-header nav a::after {
        content: "";
        position: absolute; left: 0; right: 0; bottom: -5px; height: 1.5px;
        background: var(--brand-gold);
        transform: scaleX(0); transform-origin: left center;
        transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
      }
      header.site-header nav a:hover,
      header.site-header nav a:focus-visible { color: var(--brand-gold); }
      header.site-header nav a:hover::after,
      header.site-header nav a:focus-visible::after { transform: scaleX(1); }

      h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-display);
      }

      h1 {
        font-size: 2.25rem;
        line-height: 1.2;
        margin-top: 0;
      }

      h2 {
        font-size: 1.5rem;
        margin-top: 2.5rem;
        line-height: 1.3;
      }

      h3 {
        font-size: 1.2rem;
        margin-top: 2rem;
      }

      a {
        color: var(--color-accent);
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      a:hover {
        color: var(--color-accent-hover);
      }

      /* Keyboard focus — a visible brand ring site-wide (previously only the
         leadership index defined focus styles). */
      :focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 3px;
        border-radius: 3px;
      }

      /* Skip-to-content — hidden until keyboard-focused (WCAG bypass block). */
      .skip-link {
        position: fixed; top: 0.6rem; left: 0.6rem; z-index: 100;
        transform: translateY(-160%);
        background: var(--brand-gold); color: var(--brand-night);
        padding: 0.6rem 1rem; border-radius: 6px;
        font-family: var(--font-body); font-size: 0.9rem; font-weight: 600;
        text-decoration: none;
        transition: transform 0.2s ease;
      }
      .skip-link:focus { transform: translateY(0); color: var(--brand-night); }

      @media (prefers-reduced-motion: reduce) {
        header.site-header nav a::after,
        .skip-link { transition: none; }
      }

      /* ── Scroll-reveal utility ──────────────────────────────────────────
         Elements marked [data-reveal] fade + rise as they scroll into view
         (observer added in the body script). Motion-safe: with reduced-motion
         the initial hidden state never applies, so content is present from the
         first frame. `--reveal-delay` lets callers stagger siblings. */
      @media (prefers-reduced-motion: no-preference) {
        [data-reveal] {
          opacity: 0;
          transform: translateY(18px);
          transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.22, 0.7, 0.2, 1);
          transition-delay: var(--reveal-delay, 0s);
          will-change: opacity, transform;
        }
        [data-reveal].is-visible { opacity: 1; transform: none; }
      }

      /* ── Card-list utility ──────────────────────────────────────────────
         Turns a grouped enumeration <ul> into a responsive grid of cards with a
         hover lift — the same card language as the homepage bento + leadership
         cards, reusable on any page. Semantics preserved (still ul/li). Theme-aware
         via --card-surface. For grouped, scannable items — NOT flowing prose. */
      .card-list {
        list-style: none;
        margin: 1.4rem 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
        gap: 0.85rem;
      }
      .card-list > li {
        margin: 0;
        padding: 1.1rem 1.25rem;
        background: var(--card-surface);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        line-height: 1.55;
        transition: transform 0.25s cubic-bezier(0.22, 0.7, 0.2, 1),
                    border-color 0.25s ease, box-shadow 0.25s ease;
      }
      .card-list > li:hover {
        transform: translateY(-3px);
        border-color: rgba(196, 154, 63, 0.5);
        box-shadow: 0 12px 28px -16px rgba(20, 23, 28, 0.35);
      }
      .card-list > li strong { color: var(--color-text); }
      @media (prefers-reduced-motion: reduce) { .card-list > li { transition: none; } }

      blockquote {
        border-left: 3px solid var(--color-accent);
        margin: 1.5rem 0;
        padding-left: 1.25rem;
        color: var(--color-text-muted);
        font-style: italic;
      }

      code {
        font-family: var(--font-mono);
        font-size: 0.9em;
        background: var(--surface-subtle);
        padding: 0.1rem 0.3rem;
        border-radius: 3px;
      }

      pre {
        background: #1a1a1a;
        color: #f0f0f0;
        padding: 1rem;
        border-radius: 4px;
        overflow-x: auto;
      }

      pre code {
        background: transparent;
        padding: 0;
        color: inherit;
      }

      hr {
        border: 0;
        border-top: 1px solid var(--color-border);
        margin: 3rem 0;
      }

      .author-bio {
        max-width: var(--max-width-prose);
        margin: 3rem auto 0;
        padding-top: 2rem;
        border-top: 1px solid var(--color-border);
        font-size: 0.95rem;
        color: var(--color-text-muted);
      }

      .author-bio strong {
        color: var(--color-text);
      }

      .article-lineage {
        max-width: var(--max-width-prose);
        margin: 3rem auto 0;
        padding-top: 2rem;
        border-top: 1px solid var(--color-border);
        font-size: 0.875rem;
        color: var(--color-text-muted);
      }

      .article-lineage h3 {
        font-size: 0.95rem;
        margin: 0 0 0.75rem;
        color: var(--color-text);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: bold;
      }

      .article-lineage ul {
        list-style: none;
        padding-left: 0;
        margin: 0;
      }

      .article-lineage li {
        margin-bottom: 0.5rem;
        line-height: 1.5;
      }

      .article-lineage strong {
        color: var(--color-text);
      }

      /* Footer mirrors the header as a fixed dark brand band on every page. */
      footer.site-footer {
        background: var(--brand-night);
        border-top: 1px solid rgba(255, 255, 255, 0.10);
        color: var(--brand-muted);
        font-size: 0.9rem;
        text-align: center;
        margin-top: 4rem;
      }

      footer.site-footer .footer-inner {
        max-width: var(--max-width-page);
        margin: 0 auto;
        padding: 2rem 1.5rem;
      }

      footer.site-footer .footer-nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem 1.5rem;
        margin-bottom: 1.1rem;
      }

      footer.site-footer .footer-nav a {
        color: var(--brand-muted);
        text-decoration: none;
        font-size: 0.88rem;
      }

      footer.site-footer .footer-nav a:hover {
        color: var(--brand-gold);
      }

      footer.site-footer .footer-tagline {
        margin: 0 0 0.4rem;
      }

      footer.site-footer .footer-copy {
        margin: 0;
        font-size: 0.82rem;
        color: var(--brand-muted-paper);
      }

      footer.site-footer a {
        color: var(--brand-muted);
      }

      .lead {
        font-size: 1.15rem;
        color: var(--color-text-muted);
        margin-bottom: 2rem;
      }

      .article-list {
        list-style: none;
        padding: 0;
      }

      .article-list li {
        margin-bottom: 1.5rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--color-border);
      }

      .article-list h3 {
        margin: 0 0 0.25rem;
        font-size: 1.15rem;
      }

      .article-list .meta {
        color: var(--color-text-muted);
        font-size: 0.9rem;
      }
    </style>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="logo" aria-label="al-Nizam home">
          <svg class="logo-mark" viewBox="56.5 66.7 90 90" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path fill="currentColor" d="m 66.225562,102.91471 a 33.489777,21.861039 35.771948 0 0 30.000862,26.2724 33.489777,21.861039 35.771948 0 0 28.199956,-16.23224 33.489777,21.861039 35.771948 0 0 -23.48847,-30.296333 39.626193,25.86669 35.771943 0 1 35.98779,39.271113 39.626193,25.86669 35.771943 0 1 -33.36723,19.20667 39.626193,25.86669 35.771943 0 1 -37.332908,-38.22161 z"/>
            <ellipse fill="#C49A3F" cx="80.580521" cy="88.287498" rx="6.3862953" ry="6.0728579"/>
          </svg>
          <span>al-Nizam</span>
        </a>
        <nav>
          <a href="/leadership/">Leadership</a>
          <a href="/about">About</a>
          <a href="/founder">Founder</a>
          <a href="/confidant">Confidant</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <nav class="footer-nav" aria-label="Footer">
          <a href="/about">About</a>
          <a href="/leadership/">Leadership</a>
          <a href="/founder">Founder</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href="/contact">Contact</a>
        </nav>
        <p class="footer-tagline">al-Nizam — an operating layer between operator and AI.</p>
        <p class="footer-copy">© {year} al-Nizam. All rights reserved.</p>
      </div>
    </footer>
    <script>
      // Condense the sticky header once the page scrolls away from the very top.
      // Hysteresis (condense >64, expand <12) with a dead-band between: the condense
      // changes the header height, so a SINGLE threshold thrashed on/off from
      // sub-pixel scroll jitter near the boundary (the flicker). Two thresholds with
      // a gap mean it can't oscillate — it only flips after a decisive move.
      const header = document.querySelector('header.site-header');
      if (header) {
        const CONDENSE = 64, EXPAND = 12;
        const onScroll = () => {
          const y = window.scrollY;
          if (y > CONDENSE) header.classList.add('scrolled');
          else if (y < EXPAND) header.classList.remove('scrolled');
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }
    </script>
    <script>
      // Scroll-reveal + stat count-up. Fully degradable: bails on reduced-motion or
      // when IntersectionObserver is absent, so the CSS hidden state never sticks and
      // SSR values remain (count-up spans keep their real number).
      (() => {
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) return;

        const revealEls = document.querySelectorAll('[data-reveal]');
        if (revealEls.length) {
          const io = new IntersectionObserver((entries) => {
            for (const e of entries) {
              if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
            }
          }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
          revealEls.forEach((el) => io.observe(el));
        }

        // [data-count] ticks 0 → target once on first view. Parses trailing non-digits
        // (e.g. the '+' in "40+") off the value and re-appends it each frame.
        const countEls = document.querySelectorAll('[data-count]');
        if (countEls.length) {
          const co = new IntersectionObserver((entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              const el = e.target;
              co.unobserve(el);
              const raw = String(el.dataset.count || el.textContent || '');
              const target = parseInt(raw.replace(/[^0-9]/g, ''), 10) || 0;
              const suffix = raw.replace(/[0-9,]/g, '');
              const dur = 1100, start = performance.now();
              const tick = (now) => {
                const p = Math.min(1, (now - start) / dur);
                const eased = 1 - Math.pow(1 - p, 3);
                el.textContent = Math.round(target * eased) + suffix;
                if (p < 1) requestAnimationFrame(tick);
              };
              requestAnimationFrame(tick);
            }
          }, { threshold: 0.5 });
          countEls.forEach((el) => co.observe(el));
        }
      })();
    </script>
  </body>
</html>
