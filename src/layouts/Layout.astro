---
// Base layout — Phase 0 minimal typography; brand-identity Sitting will replace
const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description ?? 'al-Nizam — an operating layer between you and AI that holds continuity, governance, and accountability structurally.'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? 'al-Nizam — an operating layer for AI-powered work.'} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://al-nizam.ai${Astro.url.pathname}`} />
    <title>{title}</title>
    <link rel="canonical" href={`https://al-nizam.ai${Astro.url.pathname}`} />
    <link rel="alternate" type="application/rss+xml" title="al-Nizam Leadership" href="/leadership/rss.xml" />
    <style is:global>
      :root {
        --color-text: #1a1a1a;
        --color-text-muted: #555;
        --color-accent: #2c5282;
        --color-bg: #fafafa;
        --color-border: #e2e2e2;
        --font-body: 'Georgia', 'Cambria', serif;
        --font-mono: 'SF Mono', 'Monaco', 'Consolas', monospace;
        --max-width-prose: 38rem;
        --max-width-page: 56rem;
      }

      * {
        box-sizing: border-box;
      }

      html {
        font-family: var(--font-body);
        font-size: 18px;
        line-height: 1.65;
        color: var(--color-text);
        background: var(--color-bg);
      }

      body {
        margin: 0;
        padding: 0;
      }

      main {
        max-width: var(--max-width-page);
        margin: 0 auto;
        padding: 2.5rem 1.5rem;
      }

      article {
        max-width: var(--max-width-prose);
        margin: 0 auto;
      }

      header.site-header {
        max-width: var(--max-width-page);
        margin: 0 auto;
        padding: 1.5rem 1.5rem 0.5rem;
        border-bottom: 1px solid var(--color-border);
      }

      header.site-header a.logo {
        font-size: 1.25rem;
        font-weight: bold;
        text-decoration: none;
        color: var(--color-text);
      }

      header.site-header nav {
        display: inline-block;
        margin-left: 2rem;
      }

      header.site-header nav a {
        margin-right: 1.5rem;
        color: var(--color-text-muted);
        text-decoration: none;
        font-size: 0.95rem;
      }

      header.site-header nav a:hover {
        color: var(--color-accent);
      }

      h1 {
        font-size: 2.25rem;
        line-height: 1.2;
        margin-top: 0;
      }

      h2 {
        font-size: 1.5rem;
        margin-top: 2.5rem;
        line-height: 1.3;
      }

      h3 {
        font-size: 1.2rem;
        margin-top: 2rem;
      }

      a {
        color: var(--color-accent);
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      a:hover {
        color: #1a365d;
      }

      blockquote {
        border-left: 3px solid var(--color-accent);
        margin: 1.5rem 0;
        padding-left: 1.25rem;
        color: var(--color-text-muted);
        font-style: italic;
      }

      code {
        font-family: var(--font-mono);
        font-size: 0.9em;
        background: #f0f0f0;
        padding: 0.1rem 0.3rem;
        border-radius: 3px;
      }

      pre {
        background: #1a1a1a;
        color: #f0f0f0;
        padding: 1rem;
        border-radius: 4px;
        overflow-x: auto;
      }

      pre code {
        background: transparent;
        padding: 0;
        color: inherit;
      }

      hr {
        border: 0;
        border-top: 1px solid var(--color-border);
        margin: 3rem 0;
      }

      .author-bio {
        max-width: var(--max-width-prose);
        margin: 3rem auto 0;
        padding-top: 2rem;
        border-top: 1px solid var(--color-border);
        font-size: 0.95rem;
        color: var(--color-text-muted);
      }

      .author-bio strong {
        color: var(--color-text);
      }

      .article-lineage {
        max-width: var(--max-width-prose);
        margin: 3rem auto 0;
        padding-top: 2rem;
        border-top: 1px solid var(--color-border);
        font-size: 0.875rem;
        color: var(--color-text-muted);
      }

      .article-lineage h3 {
        font-size: 0.95rem;
        margin: 0 0 0.75rem;
        color: var(--color-text);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: bold;
      }

      .article-lineage ul {
        list-style: none;
        padding-left: 0;
        margin: 0;
      }

      .article-lineage li {
        margin-bottom: 0.5rem;
        line-height: 1.5;
      }

      .article-lineage strong {
        color: var(--color-text);
      }

      footer.site-footer {
        max-width: var(--max-width-page);
        margin: 4rem auto 2rem;
        padding: 1.5rem;
        border-top: 1px solid var(--color-border);
        color: var(--color-text-muted);
        font-size: 0.9rem;
        text-align: center;
      }

      footer.site-footer a {
        color: var(--color-text-muted);
      }

      .lead {
        font-size: 1.15rem;
        color: var(--color-text-muted);
        margin-bottom: 2rem;
      }

      .article-list {
        list-style: none;
        padding: 0;
      }

      .article-list li {
        margin-bottom: 1.5rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--color-border);
      }

      .article-list h3 {
        margin: 0 0 0.25rem;
        font-size: 1.15rem;
      }

      .article-list .meta {
        color: var(--color-text-muted);
        font-size: 0.9rem;
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="logo">al-Nizam</a>
      <nav>
        <a href="/leadership/">Leadership</a>
        <a href="/about">About</a>
        <a href="/founder">Founder</a>
        <a href="/confidant">Confidant</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>al-Nizam — an operating layer between operator and AI.</p>
    </footer>
  </body>
</html>
