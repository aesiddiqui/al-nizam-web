---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { founder } from '../data/founder';

const links = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/aesiddiqui/' },
  { label: 'GitHub', href: 'https://github.com/aesiddiqui' },
  { label: 'Contact', href: '/contact' },
];
---

<Layout
  title='Ebadullah Siddiqui — Founder of al-Nizam'
  description={founder.description}
  theme="light"
>
  <PageHeader
    kicker="Founder"
    title={founder.pageTitle}
    subtitle={founder.subtitle}
    portrait="/founder.jpg"
    portraitAlt="Ebadullah Siddiqui — Founder of al-Nizam"
    links={links}
  />

  <article>
    <section class="dims" aria-label="Dimensions of experience">
      <p class="dims-intro">The breadth behind the framework — thirty years across:</p>
      <div class="dims-grid">
        {founder.dimensions.map((d) => (
          <div class="dim">
            <span class="dim-label">{d.label}</span>
            <span class="dim-note">{d.note}</span>
          </div>
        ))}
      </div>
    </section>

    {founder.sections.map((section) => (
      <section>
        <h2>{section.heading}</h2>
        {section.body.map((para) => (
          <p>{para}</p>
        ))}
      </section>
    ))}
  </article>
</Layout>

<style>
  /* Dimensions-of-experience strip — breadth at a glance, paper surface. */
  .dims { margin: 0 0 1rem; }
  .dims-intro {
    margin: 0 0 1rem; font-size: 0.82rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--brand-gold-ink);
  }
  .dims-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.8rem; }
  .dim {
    background: var(--brand-paper-raised); border: 1px solid rgba(20,23,28,0.10); border-radius: 10px;
    padding: 0.9rem 1rem; display: flex; flex-direction: column; gap: 0.35rem;
  }
  .dim-label { font-family: var(--font-display); font-weight: 600; font-size: 1rem; color: var(--color-text); }
  .dim-note { font-size: 0.85rem; line-height: 1.45; color: var(--color-text-muted); }
  @media (max-width: 720px) { .dims-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 460px) { .dims-grid { grid-template-columns: 1fr; } }
</style>
