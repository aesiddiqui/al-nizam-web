</style>

<style>
  .fig-table { margin: 2.6rem auto; max-width: var(--max-width-prose, 48rem); }
  .fig-table table {
    width: 100%; border-collapse: collapse; font-size: 0.95rem;
    background: #FBF8F1; border: 1px solid rgba(20,23,28,0.10);
    border-radius: 10px; overflow: hidden;
  }
