---
import Layout from '../../layouts/Layout.astro';
import { articles, allTags, hrefFor } from '../../data/articles';
---

<Layout
  title="Leadership — al-Nizam"
  description="Long-form pieces examining the disciplines al-Nizam has evolved. Memory, governance, continuity, trust, and the operating layer between operator and AI."
  theme="light"
>
  <article>
    <h1>Leadership</h1>

    <p class="lead">
      Long-form pieces examining the disciplines al-Nizam has evolved. Each piece
      takes a problem the world is already struggling with, shows how most people
      cope, then shows the structural answer al-Nizam evolved.
    </p>

    <p>
      The series accrues into a worldview rather than a feature tour. Pieces can
      be read in any order. Sequencing recommendation lives in each piece's
      header.
    </p>

    <hr />

    <h2>Articles</h2>

    <div class="tag-filter" role="group" aria-label="Filter articles by tag">
      <button class="tag-chip is-active" data-tag="*" type="button">All</button>
      {allTags.map((t) => (
        <button class="tag-chip" data-tag={t} type="button">{t}</button>
      ))}
    </div>

    <ul class="article-list" id="article-list">
      {articles.map((a) => (
        <li data-tags={a.tags.join('|')}>
          <h3><a href={hrefFor(a)}>{a.title}</a></h3>
          <p class="meta">{a.series} · {a.date}</p>
          <p>{a.description}</p>
          <p class="tags">
            {a.tags.map((t) => <span class="tag">{t}</span>)}
          </p>
        </li>
      ))}
    </ul>

    <p class="no-match" hidden>No pieces tagged that — yet.</p>

    <hr />

    <p class="lead">
      <em>More pieces in this series ship as the framework's discipline evolves.
      Each piece is built to be read alone or as part of the accumulating
      worldview. Subscribe via <a href="/leadership/rss.xml">RSS</a> to follow
      the cadence.</em>
    </p>
  </article>
</Layout>

<style>
  .tag-filter { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 1.6rem; }
  .tag-chip {
    font-family: var(--font-body); font-size: 0.82rem; line-height: 1;
    padding: 0.4rem 0.85rem; border-radius: 999px; cursor: pointer;
    border: 1px solid rgba(20,23,28,0.16); background: #FBF8F1; color: var(--color-text-muted);
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .tag-chip:hover { border-color: #C49A3F; color: #14171C; }
  .tag-chip.is-active { background: #14171C; color: #F6F3EC; border-color: #14171C; }

  .article-list .tags { margin: 0.55rem 0 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .article-list .tag {
    font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;
    color: #8A6414; background: #F3EEE1; border-radius: 4px; padding: 0.14rem 0.5rem;
  }
  .no-match { color: var(--color-text-muted); font-style: italic; }
</style>

<script>
  // Client-side tag filtering (foundation; full-text search comes later via Pagefind).
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.tag-chip'));
  const items = Array.from(document.querySelectorAll<HTMLLIElement>('#article-list > li'));
  const noMatch = document.querySelector<HTMLParagraphElement>('.no-match');
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.classList.remove('is-active'));
      chip.classList.add('is-active');
      const tag = chip.dataset.tag;
      let shown = 0;
      items.forEach((li) => {
        const tags = (li.dataset.tags || '').split('|');
        const show = tag === '*' || tags.includes(tag as string);
        li.hidden = !show;
        if (show) shown++;
      });
      if (noMatch) noMatch.hidden = shown > 0;
    });
  });
</script>
