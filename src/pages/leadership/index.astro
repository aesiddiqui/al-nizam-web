---
import Layout from '../../layouts/Layout.astro';
import { articles, allTags, hrefFor } from '../../data/articles';
---

<Layout
  title="Leadership — al-Nizam"
  description="Long-form pieces examining the disciplines al-Nizam has evolved. Memory, governance, continuity, trust, and the operating layer between operator and AI."
  theme="light"
>
  <article>
    <h1>Leadership</h1>

    <p class="lead">
      Long-form pieces examining the disciplines al-Nizam has evolved. Each piece
      takes a problem the world is already struggling with, shows how most people
      cope, then shows the structural answer al-Nizam evolved.
    </p>

    <p>
      The series accrues into a worldview rather than a feature tour. Pieces can
      be read in any order. Sequencing recommendation lives in each piece's
      header.
    </p>

    <hr />

    <div class="lead-layout">
      <div class="lead-main">
        <ul class="article-list" id="article-list">
          {articles.map((a) => (
            <li
              data-tags={a.tags.join('|')}
              data-search={`${a.title} ${a.description}`.toLowerCase()}
            >
              <h3><a href={hrefFor(a)}>{a.title}</a></h3>
              <p class="meta">{a.series} · {a.date}</p>
              <p>{a.description}</p>
            </li>
          ))}
        </ul>

        <p class="no-match" hidden>No pieces match — try clearing the filter.</p>
      </div>

      <aside class="lead-rail" aria-label="Search and filter articles">
        <form class="rail-search" role="search" onsubmit="return false">
          <label class="rail-label" for="article-search">Search</label>
          <input
            id="article-search"
            type="search"
            placeholder="Search pieces…"
            autocomplete="off"
            spellcheck="false"
          />
          <p class="rail-hint">Titles &amp; summaries. Full-text search of article bodies is coming.</p>
        </form>

        <div class="rail-filter">
          <p class="rail-label" id="filter-label">Filter by tag</p>
          <ul class="rail-tags" role="group" aria-labelledby="filter-label">
            <li><button class="rail-tag is-active" data-tag="*" type="button">All</button></li>
            {allTags.map((t) => (
              <li><button class="rail-tag" data-tag={t} type="button">{t}</button></li>
            ))}
          </ul>
        </div>
      </aside>
    </div>

    <hr />

    <p class="lead">
      <em>More pieces in this series ship as the framework's discipline evolves.
      Each piece is built to be read alone or as part of the accumulating
      worldview. Subscribe via <a href="/leadership/rss.xml">RSS</a> to follow
      the cadence.</em>
    </p>
  </article>
</Layout>

<style>
  /* Two-column: reading list is primary (left); a quiet utility rail sits right.
     Content-first in the DOM; the rail is reordered above the list on mobile. */
  .lead-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 900px) {
    .lead-layout {
      grid-template-columns: minmax(0, 1fr) 15rem;
      gap: 3rem;
      align-items: start;
    }
    .lead-main { grid-column: 1; grid-row: 1; }
    .lead-rail { grid-column: 2; grid-row: 1; }
  }
  /* Mobile: pull the rail above the list so filtering is reachable without
     scrolling past every article. */
  .lead-rail { order: -1; }

  /* ── Rail ───────────────────────────────────────────────────────────── */
  .lead-rail {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding: 1.25rem;
    background: var(--brand-paper-raised);
    border: 1px solid var(--color-border);
    border-radius: 10px;
  }
  @media (min-width: 900px) {
    .lead-rail { position: sticky; top: 5.5rem; }
  }

  .rail-label {
    margin: 0 0 0.6rem;
    font-family: var(--font-body);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--brand-muted-paper);
  }

  .rail-search { margin: 0; }
  .rail-search input {
    width: 100%;
    box-sizing: border-box;
    font-family: var(--font-body);
    font-size: 0.9rem;
    padding: 0.55rem 0.75rem;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    background: var(--brand-paper);
    color: var(--color-text);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .rail-search input::placeholder { color: var(--brand-muted-paper); }
  .rail-search input:focus {
    outline: none;
    border-color: var(--brand-gold);
    box-shadow: 0 0 0 3px rgba(196, 154, 63, 0.18);
  }
  .rail-hint {
    margin: 0.5rem 0 0;
    font-size: 0.72rem;
    line-height: 1.4;
    color: var(--brand-muted-paper);
  }

  .rail-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .rail-tag {
    font-family: var(--font-body);
    font-size: 0.8rem;
    line-height: 1;
    padding: 0.38rem 0.75rem;
    border-radius: 999px;
    cursor: pointer;
    border: 1px solid var(--color-border);
    background: var(--brand-paper);
    color: var(--color-text-muted);
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .rail-tag:hover { border-color: var(--brand-gold); color: var(--color-text); }
  .rail-tag.is-active {
    background: var(--brand-night);
    color: var(--brand-paper);
    border-color: var(--brand-night);
  }

  /* ── Article list ───────────────────────────────────────────────────── */
  .no-match { color: var(--color-text-muted); font-style: italic; }
</style>

<script>
  // Client-side narrowing: text query (title + summary) ∩ tag facet.
  // Full-text search over article bodies is the later Pagefind upgrade; the
  // input is live today over the corpus metadata so the control is never dead.
  const input = document.querySelector<HTMLInputElement>('#article-search');
  const tags = Array.from(document.querySelectorAll<HTMLButtonElement>('.rail-tag'));
  const items = Array.from(document.querySelectorAll<HTMLLIElement>('#article-list > li'));
  const noMatch = document.querySelector<HTMLParagraphElement>('.no-match');

  let activeTag = '*';
  let query = '';

  function apply() {
    const q = query.trim().toLowerCase();
    let shown = 0;
    items.forEach((li) => {
      const itemTags = (li.dataset.tags || '').split('|');
      const haystack = li.dataset.search || '';
      const tagOk = activeTag === '*' || itemTags.includes(activeTag);
      const textOk = q === '' || haystack.includes(q);
      const show = tagOk && textOk;
      li.hidden = !show;
      if (show) shown++;
    });
    if (noMatch) noMatch.hidden = shown > 0;
  }

  tags.forEach((btn) => {
    btn.addEventListener('click', () => {
      tags.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      activeTag = btn.dataset.tag || '*';
      apply();
    });
  });

  input?.addEventListener('input', () => {
    query = input.value;
    apply();
  });
</script>
