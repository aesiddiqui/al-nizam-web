---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { about } from '../data/about';
---

<Layout
  title='About al-Nizam'
  description={about.description}
  theme="light"
>
  <PageHeader kicker="About" title="al-Nizam" />

  <article>
    <p class="lead">
      {about.leadParagraph}
    </p>

    <hr />

    <figure class="fig-arch" data-reveal>
      <div class="arch">
        <div class="arch-node">
          <span class="arch-tag">The operator</span>
          sets direction · bears the risk · brings the domain judgment
        </div>
        <div class="arch-flow" aria-hidden="true">works through the layer&nbsp; ↕ &nbsp;the layer pushes back</div>
        <div class="arch-node layer">
          <span class="arch-tag gold">al-Nizam — the operating layer</span>
          <strong>memory · governance · accountability · continuity</strong>
          <span class="arch-sub">state lives in files the operator controls — outside the AI's memory entirely</span>
        </div>
        <div class="arch-flow" aria-hidden="true">engages AI natively&nbsp; ↕ &nbsp;persists what the AI cannot hold</div>
        <div class="arch-node">
          <span class="arch-tag">AI tools</span>
          the replaceable capability — Claude today, any capable model tomorrow
        </div>
      </div>
      <figcaption>
        <strong>Figure 1.</strong> al-Nizam is the operating layer between the operator and
        the AI. The operator supplies direction and judgment; the AI supplies capability; the
        layer holds memory, governance, accountability, and continuity in files the operator
        owns — so the partnership persists across sessions, models, and vendors.
      </figcaption>
    </figure>

    {about.sections.map((section) => (
      <section data-reveal>
        <h2>{section.heading}</h2>
        {section.body.map((para) => (
          <p>{para}</p>
        ))}
        {section.bullets && (
          <ul class="card-list">
            {section.bullets.map((b) => (
              <li>
                <strong>{b.strong}</strong> {b.rest}
              </li>
            ))}
          </ul>
        )}
      </section>
    ))}
  </article>
</Layout>

<style>
  /* Operating-layer architecture diagram — paper surface, matches the article
     .fig-flow / .fig-table treatments. Three tiers: operator → operating layer → AI. */
  .fig-arch { margin: 2.6rem auto; max-width: var(--max-width-prose, 48rem); }
  .fig-arch .arch { display: flex; flex-direction: column; align-items: center; gap: 0.4rem; }
  .fig-arch .arch-node {
    width: 100%; text-align: center; border-radius: 10px; padding: 0.95rem 1.1rem;
    background: var(--brand-paper-raised); border: 1px solid rgba(20,23,28,0.10); line-height: 1.5;
    font-size: 0.95rem; color: var(--color-text);
    transition: transform 0.25s cubic-bezier(0.22, 0.7, 0.2, 1), border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .fig-arch .arch-node:hover {
    transform: translateY(-2px);
    border-color: var(--brand-gold);
    box-shadow: 0 10px 24px -14px rgba(20, 23, 28, 0.3);
  }
  .fig-arch .arch-node.layer {
    background: var(--brand-paper-sunk); border-color: var(--brand-gold); border-width: 1.5px; padding: 1.15rem 1.1rem;
  }
  @media (prefers-reduced-motion: reduce) { .fig-arch .arch-node { transition: none; } }
  .fig-arch .arch-tag {
    display: block; font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.09em; color: var(--color-text-muted); margin-bottom: 0.3rem;
  }
  .fig-arch .arch-tag.gold { color: var(--brand-gold-ink); }
  .fig-arch .arch-node.layer strong { display: block; font-size: 1.05rem; color: var(--color-text); }
  .fig-arch .arch-sub { display: block; margin-top: 0.4rem; font-size: 0.85rem; color: var(--color-text-muted); }
  .fig-arch .arch-flow {
    font-size: 0.8rem; color: var(--brand-gold-ink); letter-spacing: 0.02em;
    font-family: var(--font-body); padding: 0.15rem 0;
  }
  .fig-arch figcaption { margin-top: 0.9rem; font-size: 0.9rem; color: var(--color-text-muted); line-height: 1.55; }
</style>
