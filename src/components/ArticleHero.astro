---
// ArticleHero — reusable ~45vh WebGL hero for article pages (the Tier-C hero per
// the Chronicle VISUAL-GUIDE §2C). ATMOSPHERE, not a figure: the article's concepts
// as a celestial constellation on the durable-state orbit; the in-body static figure
// carries the argument. ONE engine, parameterized by props — reuses the al-Mushahada
// 3d-force-graph engine (see PlatformGraph.astro).
//
// Props:
//   title   — the article H1 (overlaid inside the hero → the hero is the title band)
//   kicker  — small eyebrow line above the title (optional)
//   meta    — byline / series / date line under the title (optional, raw HTML ok)
//   graph   — { nodes, links } constellation (per-article; see data/hero-*.js)
//   poster  — static image shown as the hero (and, when webgl=true, the pre-load frame)
//   webgl   — opt-in live 3D. DEFAULT false: article heroes are STATIC (the poster) —
//             cheaper, portable, no per-load GPU. Reserve webgl=true for the homepage
//             entry, where one immersive moment justifies the cost. (Decided 2026-07-04.)
//
// The hero band is ALWAYS the night surface (atmosphere), even on a light-theme
// reading page — matching the brand two-surface model.
const { title, kicker, meta, graph, poster, webgl = false } = Astro.props;
const dataId = 'ah-data-' + Math.random().toString(36).slice(2, 8);
---

<header class="ah" role="banner">
  <div class="ah-stage" id="ah-stage" data-graph-id={dataId} data-webgl={String(webgl)}>
    {poster && <img class="ah-poster" src={poster} alt="" aria-hidden="true" />}
  </div>
  <script type="application/json" id={dataId} set:html={JSON.stringify(graph)}></script>

  <div class="ah-overlay">
    <div class="ah-inner">
      {kicker && <p class="ah-kicker">{kicker}</p>}
      <h1 class="ah-title">{title}</h1>
      {meta && <p class="ah-meta" set:html={meta}></p>}
    </div>
  </div>
</header>

<style>
  .ah {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    /* Sit flush under the sticky header — cancel <main>'s top padding (2.5rem)
       so no paper band shows above the night hero. */
    margin-top: -2.5rem;
    height: 45vh;
    min-height: 360px;
    max-height: 620px;
    background: #14171C;                 /* night surface — always */
    overflow: hidden;
    display: flex;
    align-items: flex-end;               /* title sits at the bottom of the band */
  }
  .ah-stage { position: absolute; inset: 0; }
  #ah-stage :global(canvas) { display: block; }
  .ah-poster {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: center;
    transition: opacity 600ms ease;
  }
  /* scrim so the overlaid title stays legible over the busy 3D field */
  .ah-overlay {
    position: relative; z-index: 2; width: 100%;
    background: linear-gradient(to top,
      rgba(20,23,28,0.97) 0%, rgba(20,23,28,0.88) 30%,
      rgba(20,23,28,0.45) 68%, rgba(20,23,28,0) 100%);
    padding: 8rem 0 1.8rem;
    pointer-events: none;
  }
  .ah-inner { width: 100%; max-width: 48rem; margin: 0 auto; padding: 0 1.5rem; }
  .ah-kicker {
    margin: 0 0 0.5rem; font-size: 0.78rem; letter-spacing: 0.14em;
    text-transform: uppercase; color: #C49A3F;
  }
  .ah-title {
    margin: 0; color: #F6F3EC; font-family: var(--font-display); font-weight: 600;
    font-size: clamp(1.7rem, 4.2vw, 2.9rem); line-height: 1.12; letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .ah-meta { margin: 0.9rem 0 0; color: #8A93A3; font-size: 0.9rem; }
  .ah-meta :global(a) { color: #C49A3F; }
  @media (max-width: 760px) { .ah { height: 32vh; min-height: 300px; } .ah-overlay { padding-top: 3.5rem; } }
  @media (prefers-reduced-motion: reduce) { .ah-poster { opacity: 1 !important; } }
</style>

<script>
  import ForceGraph3D from '3d-force-graph';
  import SpriteText from 'three-spritetext';
  import * as THREE from 'three';

  const stage = document.getElementById('ah-stage');
  const dataEl = stage && document.getElementById(stage.dataset.graphId);
  const poster = stage && stage.querySelector('.ah-poster');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Static by default (webgl opt-in), reduced-motion, or no data → keep the static
  // poster, never spin up WebGL. Only the homepage (webgl=true) runs the live engine.
  const webglOn = stage && stage.dataset.webgl === 'true';
  if (stage && dataEl && webglOn && !reduceMotion) {
    const graph = JSON.parse(dataEl.textContent);
    const REL = 5;
    const val = (n) => n.val || 4;

    const Graph = ForceGraph3D({ controlType: 'orbit' })(stage)
      .backgroundColor('rgba(0,0,0,0)')
      .graphData(graph)
      .nodeRelSize(REL)
      .nodeVal(val)
      .nodeThreeObjectExtend(false)
      .nodeThreeObject((n) => {
        const radius = Math.cbrt(val(n)) * REL;
        const ghost = n.kind === 'ghost';
        const group = new THREE.Group();
        const geo = new THREE.SphereGeometry(radius, 24, 24);
        const mat = new THREE.MeshStandardMaterial({
          color: new THREE.Color(n.color), roughness: 1.0, metalness: 0.0,
          transparent: true, opacity: ghost ? 0.28 : 0.95,
        });
        group.add(new THREE.Mesh(geo, mat));
        // Label only the anchors + tiers (atmosphere, not a labelled diagram).
        if (n.kind === 'anchor' || n.kind === 'tier') {
          const h = n.kind === 'anchor' ? 5 : 3.6;
          const s = new SpriteText(n.label);
          s.color = n.kind === 'anchor' ? '#F6F3EC' : '#E6C66E';
          s.fontFace = 'Georgia, serif';
          s.textHeight = h;
          s.position.set(0, -(radius + h / 2 + 2.5), 0);
          group.add(s);
        }
        return group;
      })
      .linkColor((l) => (l.kind === 'ghost' ? 'rgba(138,147,163,0.35)' : 'rgba(230,198,110,0.9)'))
      .linkWidth((l) => (l.kind === 'ghost' ? 0.4 : 1.0))
      .linkDirectionalParticles((l) => (l.kind === 'ghost' ? 0 : 2))
      .linkDirectionalParticleWidth(1.3)
      .linkDirectionalParticleColor(() => '#E6C66E')
      .width(stage.clientWidth)
      .height(stage.clientHeight);

    // Spread the constellation into a calm, wide field (a backdrop, not a clump).
    Graph.d3Force('charge').strength(-220);
    if (Graph.d3Force('link')) Graph.d3Force('link').distance(58);

    const controls = Graph.controls();
    controls.autoRotate = true;
    controls.autoRotateSpeed = 0.5;        // subtle celestial drift (not a carousel)
    controls.enableDamping = true;
    controls.dampingFactor = 0.12;
    controls.enableZoom = false;           // hero is atmosphere; don't hijack page scroll

    // Seat the constellation as a contained backdrop in the upper band, clear of the
    // overlaid title (which sits bottom-left). Generous padding keeps it compact; a small
    // upward camera offset lifts it above the headline.
    function seat() {
      // Big atmospheric backdrop filling the band; the strong bottom scrim keeps the
      // overlaid title legible over it. (Padding is the size dial — lower = bigger.)
      Graph.zoomToFit(800, 30);   // starting default — dial live via `npm run dev`
      if (poster) poster.style.opacity = '0';
    }
    let fitted = false;
    Graph.onEngineStop(() => { if (!fitted) { seat(); fitted = true; } });
    setTimeout(seat, 1800);

    const ro = new ResizeObserver(() => Graph.width(stage.clientWidth).height(stage.clientHeight));
    ro.observe(stage);
  }
</script>
