---
// al-Mushahada public showcase — the framework observing itself, in 3D.
// Renders the curated, default-deny public graph (src/data/platform-graph.js).
// `hero` (homepage): the headline lives in the page hero band above, so the
// component hides its own h2/lede and the graph stage goes full-bleed.
import { meta } from '../data/platform-graph.js';
const { hero = false } = Astro.props;
---

<section class={`platform-graph${hero ? ' pg-hero' : ''}`} aria-label="al-Nizam platform architecture">
  <h2>The architecture, observing itself</h2>
  <p class="pg-lede">
    al-Nizam isn’t one capability bolted onto AI — it’s one composed system. Every
    discipline is a substrate; substrates compose into families; families compose into the
    operating layer. This is the framework’s own live map, generated by
    <strong>al-Mushahada</strong> — the substrate that lets the framework see itself.
  </p>

  <div class="pg-stats" data-reveal>
    <div class="pg-stat"><span class="pg-num" data-count={meta.families}>{meta.families}</span><span class="pg-lab">families</span></div>
    <div class="pg-stat"><span class="pg-num" data-count={meta.substrates}>{meta.substrates}</span><span class="pg-lab">substrates</span></div>
    <div class="pg-stat"><span class="pg-num" data-count={meta.disciplines}>{meta.disciplines}</span><span class="pg-lab">codified disciplines &amp; decisions</span></div>
    <div class="pg-stat"><span class="pg-num" data-count={meta.chapters}>{meta.chapters}</span><span class="pg-lab">canonical specs</span></div>
    <div class="pg-stat"><span class="pg-num" data-count={meta.skills}>{meta.skills}</span><span class="pg-lab">skills</span></div>
    <div class="pg-stat"><span class="pg-num" data-count={meta.hooks}>{meta.hooks}</span><span class="pg-lab">enforcement hooks</span></div>
  </div>

  <div class="pg-stage">
    <div id="pg-cy"></div>
  </div>
  <div id="pg-panel" class="pg-readout">
    <p class="pg-hint"><strong>Drag to orbit · scroll to zoom · click a node.</strong> Lit nodes are named capabilities; dim nodes are real substrates held private — the map shows true breadth, not internals.</p>
  </div>

  <p class="pg-arc">
    From one-off scripts and documents → through a project where AI created more chaos than it
    solved → to running multiple client engagements concurrently, across machines, without fear
    of losing state. <em>This is what that journey built.</em>
  </p>
</section>

<style>
  /* Align to the same centered prose column as the article text above/below. */
  .platform-graph { width: 100%; max-width: var(--max-width-prose); box-sizing: border-box; margin: 3.5rem auto 0; }
  .platform-graph h2 { margin-bottom: 0.5rem; }
  .pg-lede { color: var(--color-text-muted); max-width: var(--max-width-prose); }
  .pg-stats { display: flex; flex-wrap: wrap; gap: 1.6rem 2.2rem; margin: 1.6rem 0 1.2rem; }
  .pg-stat { display: flex; flex-direction: column; }
  .pg-num { font-size: 1.8rem; font-weight: 700; color: var(--brand-gold); line-height: 1.1; }
  .pg-lab { font-size: 0.8rem; color: var(--color-text-muted); letter-spacing: 0.02em; }
  /* No frame — the transparent 3D canvas blends straight into the page. */
  .pg-stage { position: relative; width: 100%; height: 580px; margin-top: 0.5rem; }
  #pg-cy { width: 100%; height: 100%; }
  .pg-readout { min-height: 4rem; margin-top: 1rem; max-width: var(--max-width-prose); }
  .pg-readout h3 { font-family: var(--font-display); font-size: 1.2rem; margin: 0 0 0.4rem; color: var(--brand-paper); }
  .pg-readout .pg-fam { font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.09em; color: var(--brand-gold); margin: 0 0 0.5rem; }
  .pg-readout h3 .pg-en { font-family: var(--font-display); font-style: italic; font-weight: 400; font-size: 0.9rem; color: var(--brand-muted); }
  .pg-readout p { font-size: 0.95rem; color: #C7CCD6; margin: 0; line-height: 1.6; }
  .pg-readout .pg-more { margin-top: 0.7rem; }
  .pg-readout .pg-more a { font-size: 0.9rem; color: var(--brand-gold); text-decoration: none; border-bottom: 1px solid rgba(201,162,75,0.4); }
  .pg-readout .pg-more a:hover { color: var(--brand-star); border-bottom-color: var(--brand-star); }
  .pg-hint { color: var(--brand-muted) !important; font-size: 0.88rem !important; }
  .pg-arc { margin-top: 1.6rem; color: var(--color-text-muted); max-width: var(--max-width-prose); }
  @media (max-width: 760px) { .pg-stage { height: 460px; } }

  /* Hero mode — the page hero band carries the headline, so suppress the
     component's own h2/lede. The graph is the first thing the visitor meets
     (full-bleed); the maturity stats move BELOW it — the architecture greets
     you, the numbers reward the scroll. */
  /* Hero zone shares one content column (48rem) — wider than the 38rem reading
     prose so the six-stat strip fits comfortably, and everything (readout,
     stats, arc) aligns to the same edges. The full-bleed stage ignores this. */
  .platform-graph.pg-hero { margin-top: 0; display: flex; flex-direction: column; max-width: 48rem; }
  .platform-graph.pg-hero h2,
  .platform-graph.pg-hero .pg-lede { display: none; }
  .platform-graph.pg-hero .pg-stage {
    order: 1;
    width: 100vw;
    /* Same clean margin-only full-bleed as the hero band. */
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    height: 70vh;
    min-height: 520px;
    margin-top: 0;
  }
  .platform-graph.pg-hero .pg-readout { order: 2; }
  /* Hero stats — all six on one row, sized to the same 48rem column as the
     readout/arc so the strip aligns instead of overhanging. space-between fills
     the column edge-to-edge; numbers + gaps scale with the viewport (clamp) so
     it stays one line and resizes fluidly; wraps under 760px for phones. */
  .platform-graph.pg-hero .pg-stats {
    order: 3;
    flex-wrap: nowrap;
    justify-content: space-between;
    align-items: start;
    gap: clamp(0.4rem, 1.6vw, 1.4rem);
    width: 100%;
    margin: 2.4rem 0 0;
  }
  .platform-graph.pg-hero .pg-stat { min-width: 0; align-items: center; text-align: center; }
  .platform-graph.pg-hero .pg-num { font-size: clamp(1.1rem, 2.4vw, 1.7rem); }
  .platform-graph.pg-hero .pg-readout,
  .platform-graph.pg-hero .pg-arc { max-width: 100%; }
  @media (max-width: 760px) {
    .platform-graph.pg-hero .pg-stats { flex-wrap: wrap; justify-content: center; gap: 1.2rem 1.6rem; }
  }
  .platform-graph.pg-hero .pg-arc { order: 4; }
  @media (max-width: 760px) {
    .platform-graph.pg-hero .pg-stage { height: 60vh; min-height: 400px; }
  }
</style>

<script>
  import ForceGraph3D from '3d-force-graph';
  import SpriteText from 'three-spritetext';
  import * as THREE from 'three';
  import { graph, familyLabel } from '../data/platform-graph.js';

  // Brand palette for the WebGL layer. Canvas / Three.js cannot read CSS custom
  // properties, so the brand colors the graph draws are centralized here as JS
  // constants — mirroring Layout's --brand-* tokens, so a brand-color change for
  // the graph is a single edit in this block (the CSS-var equivalent for canvas).
  const BRAND = {
    night: '#14171C', // --brand-night
    paper: '#F6F3EC', // --brand-paper
    gold: '#C49A3F',  // --brand-gold
    star: '#E6C66E',  // --brand-star
    muted: '#8A93A3', // --brand-muted
    label: '#D6DAE3', // graph-only: secondary node label (no brand token)
    link: 'rgba(155,175,210,0.95)', // graph-only: neutral (non-composition) link
  };

  // Sphere radius matches 3d-force-graph's own formula: cbrt(nodeVal) * nodeRelSize.
  // Computed once here so the matte sphere and the label offset always agree.
  const NODE_REL_SIZE = 4;
  function nodeVal(n) {
    return n.level === 3 ? 28 : n.level === 2 ? 7 : n.kind === 'named' ? 3.5 : 1.1;
  }
  function nodeRadius(n) {
    return Math.cbrt(nodeVal(n)) * NODE_REL_SIZE;
  }

  const el = document.getElementById('pg-cy');
  const panel = document.getElementById('pg-panel');
  if (el && panel) {
    const defaultHTML = panel.innerHTML;

    const Graph = ForceGraph3D({ controlType: 'orbit' })(el)
      .backgroundColor('rgba(0,0,0,0)')
      .graphData(graph)
      .nodeRelSize(NODE_REL_SIZE)
      .nodeVal(nodeVal)
      .nodeLabel((n) => (n.kind === 'anon' ? 'a private capability' : (n.en ? n.label + ' · ' + n.en : n.label)))
      .nodeThreeObjectExtend(false)
      .nodeThreeObject((n) => {
        const radius = nodeRadius(n);
        const isAnon = n.kind === 'anon';
        const group = new THREE.Group();

        // Matte sphere — high roughness, zero metalness, no specular sheen.
        // Round shape kept; just the soft, non-glossy stone surface.
        const geo = new THREE.SphereGeometry(radius, 24, 24);
        const mat = new THREE.MeshStandardMaterial({
          color: new THREE.Color(n.color),
          roughness: 1.0,
          metalness: 0.0,
          flatShading: false,
          transparent: true,
          opacity: isAnon ? 0.5 : 0.98,
          // Self-illumination so nodes glow against the night and read THROUGH the
          // hero scrim — named/core/family shine; private nodes stay a dim ember.
          emissive: new THREE.Color(n.color),
          emissiveIntensity: isAnon ? 0.12 : 0.5,
        });
        group.add(new THREE.Mesh(geo, mat));

        // Label — skipped for anonymous (private) nodes. Offset is DYNAMIC:
        // clears the actual sphere radius + half the text height + a gap, so big
        // spheres no longer swallow their own name.
        if (!isAnon) {
          const primaryH = n.kind === 'core' ? 7 : n.kind === 'family' ? 4.2 : 3.2;
          const gap = 3;
          const s = new SpriteText(n.label);
          s.color = n.kind === 'core' ? BRAND.paper : BRAND.label;
          s.fontFace = 'Spectral, Georgia, serif';
          s.textHeight = primaryH;
          s.fontWeight = n.kind === 'core' ? 'bold' : 'normal';
          const primaryY = -(radius + primaryH / 2 + gap);
          s.position.set(0, primaryY, 0);
          group.add(s);

          // Secondary English bridge — smaller + muted, stacked just below the
          // primary. Layered-vocabulary discipline: Arabic carries the brand, the
          // English is a quiet comprehension aid (omitted where the name is already
          // English). Only renders when the node declares an `en` value.
          if (n.en) {
            const secH = primaryH * 0.62;
            const sub = new SpriteText(n.en);
            sub.color = BRAND.muted;
            sub.fontFace = 'Spectral, Georgia, serif';
            sub.textHeight = secH;
            sub.position.set(0, primaryY - (primaryH / 2 + secH / 2 + 1.2), 0);
            group.add(sub);
          }
        }
        return group;
      })
      .linkColor((l) => (l.kind === 'composition' ? BRAND.star : BRAND.link))
      .linkOpacity(0.85)
      .linkWidth((l) => (l.kind === 'composition' ? 1.1 : 0.55))
      .linkDirectionalParticles((l) => (l.kind === 'composition' ? 2 : 0))
      .linkDirectionalParticleWidth(1.4)
      .linkDirectionalParticleColor(() => BRAND.star)
      .width(el.clientWidth)
      .height(el.clientHeight);

    // Gentle auto-orbit (OrbitControls) — disabled when the visitor prefers
    // reduced motion (accessibility; the graph stays fully drag-to-orbit).
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const controls = Graph.controls();
    controls.autoRotate = !reduceMotion;
    controls.autoRotateSpeed = 0.55;
    controls.enableDamping = true;
    controls.dampingFactor = 0.12;

    // Node-focus flag — true while a node is selected (camera flown to it).
    let nodeFocused = false;

    // Fit the graph to the frame once the force layout settles (and as a fallback).
    let fitted = false;
    Graph.onEngineStop(() => { if (!fitted) { Graph.zoomToFit(700, 55); fitted = true; } });
    setTimeout(() => Graph.zoomToFit(700, 55), 1600);

    // Label sprites render in the fallback (Georgia) until Spectral finishes loading;
    // regenerate them once the brand display face is ready so the floating names match.
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => { try { Graph.refresh(); } catch (e) {} });
    }

    // ── Record mode ──────────────────────────────────────────────────────────
    // Visit ?record to produce the homepage hero loop. NOT a production path — it
    // drives a DETERMINISTIC, seamless-looping cinematic camera and captures the
    // canvas to a WebM (auto-downloads hero.webm), which then ships as a
    // pre-rendered <video>. Why pre-render rather than run this live: (1) the live
    // cinematic fought OrbitControls' damping — controls.update() eased toward its
    // internal spherical every frame and OVERWROTE each cameraPosition() write, so
    // the view stayed static; (2) it cost a live GPU render on every homepage
    // visit. A recorded loop gives full art-direction, zero runtime camera-fight,
    // and a mobile/reduced-motion-safe poster fallback. The interactive graph keeps
    // its own surface (below the fold), where drag-to-orbit is the point.
    //
    // The one-line root cause of the live bug was enableDamping=true. Record mode
    // sets damping OFF (+ autoRotate OFF + input disabled) so controls.update()
    // becomes a no-op relative to our per-frame write and the motion renders.
    const recordMode = new URLSearchParams(location.search).has('record');
    if (recordMode) {
      const V3 = THREE.Vector3;
      const REC_W = 1920, REC_H = 1080, REC_D = 24000; // one seamless loop (ms)
      const camera = Graph.camera();

      // Opaque night background (matches the site hero band → no alpha compositing);
      // fixed 16:9 DRAWING BUFFER so the shipped <video> covers any viewport via
      // object-fit. The buffer (1920×1080) is what MediaRecorder captures.
      Graph.backgroundColor(BRAND.night).width(REC_W).height(REC_H);
      // Preview only: pin the stage to the full window and scale the canvas to fit
      // (object-fit:contain letterboxes the whole 16:9 frame so it's judgeable) —
      // this is DISPLAY size, independent of the 1920×1080 capture buffer.
      el.style.cssText = 'position:fixed;inset:0;width:100vw;height:100vh;z-index:1;';
      const previewCanvas = el.querySelector('canvas');
      if (previewCanvas) previewCanvas.style.cssText = 'width:100%;height:100%;object-fit:contain;';

      // Kill every camera-override source: damping (the culprit), autoRotate, input.
      controls.enableDamping = false;
      controls.autoRotate = false;
      controls.enabled = false;

      // ── Tunable feel — each maps to what you SEE on screen ──
      const R_CENTER = 0.50;  // zoom baseline (× fit distance); LOWER = closer
      const R_AMP = 0.24;     // ZOOM range — how far it dollies in/out each loop
      const SWEEP_EW = 0.30;  // EAST–WEST travel across the frame (× fit radius)
      const SWEEP_NS = 0.10;  // NORTH–SOUTH travel across the frame (× fit radius)
      const BOB = 0.16;       // orbit tilt (radians) — extra up/down lean
      const TAU = Math.PI * 2;

      const status = document.createElement('div');
      status.style.cssText = 'position:fixed;top:8px;left:8px;z-index:99999;background:#000;color:#E6C66E;font:13px/1.5 monospace;padding:6px 10px;border:1px solid #C49A3F;white-space:pre;';
      status.textContent = 'record: warming up (layout settling)…';
      document.body.appendChild(status);

      // Capture button — recording NO LONGER auto-fires on load (that spammed a new
      // download on every HMR reload / revisit). ?record now just LOOPS the motion
      // for judging; click to capture exactly ONE seamless 24s loop → hero.webm.
      const btn = document.createElement('button');
      btn.textContent = '⏺ Capture 24s loop';
      btn.style.cssText = 'position:fixed;top:44px;left:8px;z-index:99999;background:#C49A3F;color:#14171C;font:13px/1.4 system-ui;font-weight:700;padding:7px 12px;border:0;border-radius:4px;cursor:pointer;';
      document.body.appendChild(btn);

      let baseR = 600, theta0 = 0, phi0 = Math.PI / 2;
      const c = new V3();
      let ready = false, loopStart = 0, capturing = false;

      // Settle the layout ~3.2s, fit, seed the orbit — then the preview loops.
      setTimeout(() => {
        Graph.zoomToFit(0, 55);
        setTimeout(() => {
          c.copy(controls.target);
          const off = camera.position.clone().sub(c);
          baseR = off.length() || 600;
          const s0 = new THREE.Spherical().setFromVector3(off);
          theta0 = s0.theta; phi0 = s0.phi;
          loopStart = performance.now();
          ready = true;
          status.textContent = 'record: PREVIEW looping — judge it, then ⏺ Capture';
        }, 800);
      }, 3200);

      btn.onclick = () => {
        if (!ready || capturing) return;
        capturing = true;
        loopStart = performance.now();           // restart at u=0 for a clean loop
        const canvas = el.querySelector('canvas');
        const stream = canvas.captureStream(60);
        const rec = new MediaRecorder(stream, { mimeType: 'video/webm;codecs=vp9', videoBitsPerSecond: 12000000 });
        const chunks = [];
        rec.ondataavailable = (e) => { if (e.data.size) chunks.push(e.data); };
        rec.onstop = () => {
          const blob = new Blob(chunks, { type: 'video/webm' });
          const dl = (href, name) => { const a = document.createElement('a'); a.href = href; a.download = name; a.click(); };
          dl(URL.createObjectURL(blob), 'hero.webm');
          status.textContent = 'record: hero.webm (' + Math.round(blob.size / 1024) + ' KB) — making poster…';
          // Derive a poster STILL from the recorded loop (no ffmpeg): play the blob
          // into an offscreen <video>, seek to a frame, draw to a 2D canvas, export
          // JPEG. Drawing a video frame needs no preserveDrawingBuffer (unlike the
          // WebGL canvas), so one Capture click yields BOTH hero.webm + hero-poster.jpg.
          let done = false;
          const finish = (msg) => { if (done) return; done = true; capturing = false; status.textContent = msg; };
          const v = document.createElement('video');
          v.muted = true; v.playsInline = true; v.src = URL.createObjectURL(blob);
          v.addEventListener('loadeddata', () => { try { v.currentTime = 1.0; } catch (e) {} });
          v.addEventListener('seeked', () => {
            try {
              const cv = document.createElement('canvas');
              cv.width = REC_W; cv.height = REC_H;
              cv.getContext('2d').drawImage(v, 0, 0, REC_W, REC_H);
              cv.toBlob((pb) => { if (pb) dl(URL.createObjectURL(pb), 'hero-poster.jpg'); finish('record: DONE — hero.webm + hero-poster.jpg downloaded. Reload to re-judge.'); }, 'image/jpeg', 0.9);
            } catch (e) { finish('record: hero.webm done; poster failed (' + e.message + '). I can derive it later.'); }
          });
          setTimeout(() => finish('record: hero.webm done; poster timed out — I can derive it later.'), 5000);
        };
        rec.start();
        setTimeout(() => rec.stop(), REC_D + 60);
      };

      // Continuous deterministic camera — loops forever for preview; a capture grabs
      // exactly one REC_D cycle from a fresh loopStart, so frame(0)==frame(D).
      (function drive(now) {
        requestAnimationFrame(drive);
        if (!ready) return;
        const u = ((now - loopStart) % REC_D) / REC_D;
        // Orbit around the fixed graph centre.
        const theta = theta0 + TAU * u;                    // azimuthal spin
        const phi = phi0 + BOB * Math.sin(TAU * u);        // orbit tilt (up/down lean)
        const rFac = R_CENTER + R_AMP * Math.sin(TAU * u); // ONE deep zoom breath/loop
        const s = new THREE.Spherical(baseR * rFac, phi, theta);
        const camPos = new V3().setFromSpherical(s).add(c);
        // SCREEN-SPACE pan of the whole shot: offset camera AND target together along
        // the camera's own right/up axes, so the graph slides E–W / N–S across the
        // frame predictably at any orbit angle (world-space travel didn't map to the
        // screen). Camera + target move as one → a pure pan, not a re-aim.
        const dir = new V3().subVectors(camPos, c).normalize();
        const right = new V3().crossVectors(new V3(0, 1, 0), dir).normalize();
        const up = new V3().crossVectors(dir, right).normalize();
        const pan = right.multiplyScalar(baseR * SWEEP_EW * Math.sin(TAU * u))
          .add(up.multiplyScalar(baseR * SWEEP_NS * Math.cos(TAU * u)));
        const posF = camPos.add(pan);
        const tgtF = new V3().copy(c).add(pan);
        Graph.cameraPosition({ x: posF.x, y: posF.y, z: posF.z }, tgtF, 0);
        if (capturing) status.textContent = 'record: capturing… ' + Math.round(u * 100) + '%';
      })(performance.now());
    }

    Graph.onNodeClick((node) => {
      nodeFocused = true;
      controls.autoRotate = false;
      if (node.kind === 'anon') {
        panel.innerHTML =
          '<p class="pg-fam">' + familyLabel(node.family) + '</p>' +
          '<h3>A private capability</h3>' +
          '<p>A real substrate in this family, held private. The map shows the framework’s true breadth; the internals stay internal.</p>';
      } else if (node.desc) {
        const fam = node.kind === 'named' ? '<p class="pg-fam">' + familyLabel(node.family) + '</p>' : '';
        const en = node.en ? ' <span class="pg-en">· ' + node.en + '</span>' : '';
        // Doc-link slot — dormant until a node declares a `doc` slug (Slice C).
        const more = node.doc ? '<p class="pg-more"><a href="' + node.doc + '">Read more →</a></p>' : '';
        panel.innerHTML = fam + '<h3>' + node.label + en + '</h3><p>' + node.desc + '</p>' + more;
      }
      // Fly the camera to the node.
      const d = 90;
      const r = 1 + d / Math.hypot(node.x || 1, node.y || 1, node.z || 1);
      Graph.cameraPosition({ x: (node.x || 0) * r, y: (node.y || 0) * r, z: (node.z || 0) * r }, node, 1400);
    });

    Graph.onBackgroundClick(() => {
      nodeFocused = false;
      panel.innerHTML = defaultHTML;
      controls.autoRotate = !reduceMotion;
      Graph.zoomToFit(600, 55);
    });

    // Resize with container.
    const ro = new ResizeObserver(() => Graph.width(el.clientWidth).height(el.clientHeight));
    ro.observe(el);
  }
</script>
