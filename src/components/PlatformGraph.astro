---
// al-Mushahada public showcase — the framework observing itself, in 3D.
// Renders the curated, default-deny public graph (src/data/platform-graph.js).
// `hero` (homepage): the headline lives in the page hero band above, so the
// component hides its own h2/lede and the graph stage goes full-bleed.
import { meta } from '../data/platform-graph.js';
const { hero = false } = Astro.props;
---

<section class={`platform-graph${hero ? ' pg-hero' : ''}`} aria-label="al-Nizam platform architecture">
  <h2>The architecture, observing itself</h2>
  <p class="pg-lede">
    al-Nizam isn’t one capability bolted onto AI — it’s one composed system. Every
    discipline is a substrate; substrates compose into families; families compose into the
    operating layer. This is the framework’s own live map, generated by
    <strong>al-Mushahada</strong> — the substrate that lets the framework see itself.
  </p>

  <div class="pg-stats">
    <div class="pg-stat"><span class="pg-num">{meta.families}</span><span class="pg-lab">families</span></div>
    <div class="pg-stat"><span class="pg-num">{meta.substrates}</span><span class="pg-lab">substrates</span></div>
    <div class="pg-stat"><span class="pg-num">{meta.disciplines}</span><span class="pg-lab">codified disciplines &amp; decisions</span></div>
    <div class="pg-stat"><span class="pg-num">{meta.chapters}</span><span class="pg-lab">canonical specs</span></div>
    <div class="pg-stat"><span class="pg-num">{meta.skills}</span><span class="pg-lab">skills</span></div>
    <div class="pg-stat"><span class="pg-num">{meta.hooks}</span><span class="pg-lab">enforcement hooks</span></div>
  </div>

  <div class="pg-stage">
    <div id="pg-cy"></div>
  </div>
  <div id="pg-panel" class="pg-readout">
    <p class="pg-hint"><strong>Drag to orbit · scroll to zoom · click a node.</strong> Lit nodes are named capabilities; dim nodes are real substrates held private — the map shows true breadth, not internals.</p>
  </div>

  <p class="pg-arc">
    From one-off scripts and documents → through a project where AI created more chaos than it
    solved → to running multiple client engagements concurrently, across machines, without fear
    of losing state. <em>This is what that journey built.</em>
  </p>
</section>

<style>
  /* Align to the same centered prose column as the article text above/below. */
  .platform-graph { width: 100%; max-width: var(--max-width-prose); box-sizing: border-box; margin: 3.5rem auto 0; }
  .platform-graph h2 { margin-bottom: 0.5rem; }
  .pg-lede { color: var(--color-text-muted); max-width: var(--max-width-prose); }
  .pg-stats { display: flex; flex-wrap: wrap; gap: 1.6rem 2.2rem; margin: 1.6rem 0 1.2rem; }
  .pg-stat { display: flex; flex-direction: column; }
  .pg-num { font-size: 1.8rem; font-weight: 700; color: #C9A24B; line-height: 1.1; }
  .pg-lab { font-size: 0.8rem; color: var(--color-text-muted); letter-spacing: 0.02em; }
  /* No frame — the transparent 3D canvas blends straight into the page. */
  .pg-stage { position: relative; width: 100%; height: 580px; margin-top: 0.5rem; }
  #pg-cy { width: 100%; height: 100%; }
  .pg-readout { min-height: 4rem; margin-top: 1rem; max-width: var(--max-width-prose); }
  .pg-readout h3 { font-family: Georgia, serif; font-size: 1.2rem; margin: 0 0 0.4rem; color: #F6F3EC; }
  .pg-readout .pg-fam { font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.09em; color: #C9A24B; margin: 0 0 0.5rem; }
  .pg-readout h3 .pg-en { font-family: Georgia, serif; font-style: italic; font-weight: 400; font-size: 0.9rem; color: #8A93A3; }
  .pg-readout p { font-size: 0.95rem; color: #C7CCD6; margin: 0; line-height: 1.6; }
  .pg-readout .pg-more { margin-top: 0.7rem; }
  .pg-readout .pg-more a { font-size: 0.9rem; color: #C9A24B; text-decoration: none; border-bottom: 1px solid rgba(201,162,75,0.4); }
  .pg-readout .pg-more a:hover { color: #E6C66E; border-bottom-color: #E6C66E; }
  .pg-hint { color: #8A93A3 !important; font-size: 0.88rem !important; }
  .pg-arc { margin-top: 1.6rem; color: var(--color-text-muted); max-width: var(--max-width-prose); }
  @media (max-width: 760px) { .pg-stage { height: 460px; } }

  /* Hero mode — the page hero band carries the headline, so suppress the
     component's own h2/lede. The graph is the first thing the visitor meets
     (full-bleed); the maturity stats move BELOW it — the architecture greets
     you, the numbers reward the scroll. */
  .platform-graph.pg-hero { margin-top: 0; display: flex; flex-direction: column; }
  .platform-graph.pg-hero h2,
  .platform-graph.pg-hero .pg-lede { display: none; }
  .platform-graph.pg-hero .pg-stage {
    order: 1;
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    height: 70vh;
    min-height: 520px;
    margin-top: 0;
  }
  .platform-graph.pg-hero .pg-readout { order: 2; }
  .platform-graph.pg-hero .pg-stats { order: 3; justify-content: center; margin: 2.4rem 0 0; }
  .platform-graph.pg-hero .pg-arc { order: 4; }
  @media (max-width: 760px) {
    .platform-graph.pg-hero .pg-stage { height: 60vh; min-height: 400px; }
  }
</style>

<script>
  import ForceGraph3D from '3d-force-graph';
  import SpriteText from 'three-spritetext';
  import * as THREE from 'three';
  import { graph, familyLabel } from '../data/platform-graph.js';

  // Sphere radius matches 3d-force-graph's own formula: cbrt(nodeVal) * nodeRelSize.
  // Computed once here so the matte sphere and the label offset always agree.
  const NODE_REL_SIZE = 4;
  function nodeVal(n) {
    return n.level === 3 ? 28 : n.level === 2 ? 7 : n.kind === 'named' ? 3.5 : 1.1;
  }
  function nodeRadius(n) {
    return Math.cbrt(nodeVal(n)) * NODE_REL_SIZE;
  }

  const el = document.getElementById('pg-cy');
  const panel = document.getElementById('pg-panel');
  if (el && panel) {
    const defaultHTML = panel.innerHTML;

    const Graph = ForceGraph3D({ controlType: 'orbit' })(el)
      .backgroundColor('rgba(0,0,0,0)')
      .graphData(graph)
      .nodeRelSize(NODE_REL_SIZE)
      .nodeVal(nodeVal)
      .nodeLabel((n) => (n.kind === 'anon' ? 'a private capability' : (n.en ? n.label + ' · ' + n.en : n.label)))
      .nodeThreeObjectExtend(false)
      .nodeThreeObject((n) => {
        const radius = nodeRadius(n);
        const isAnon = n.kind === 'anon';
        const group = new THREE.Group();

        // Matte sphere — high roughness, zero metalness, no specular sheen.
        // Round shape kept; just the soft, non-glossy stone surface.
        const geo = new THREE.SphereGeometry(radius, 24, 24);
        const mat = new THREE.MeshStandardMaterial({
          color: new THREE.Color(n.color),
          roughness: 1.0,
          metalness: 0.0,
          flatShading: false,
          transparent: true,
          opacity: isAnon ? 0.42 : 0.95,
        });
        group.add(new THREE.Mesh(geo, mat));

        // Label — skipped for anonymous (private) nodes. Offset is DYNAMIC:
        // clears the actual sphere radius + half the text height + a gap, so big
        // spheres no longer swallow their own name.
        if (!isAnon) {
          const primaryH = n.kind === 'core' ? 7 : n.kind === 'family' ? 4.2 : 3.2;
          const gap = 3;
          const s = new SpriteText(n.label);
          s.color = n.kind === 'core' ? '#F6F3EC' : '#D6DAE3';
          s.fontFace = 'Georgia, serif';
          s.textHeight = primaryH;
          s.fontWeight = n.kind === 'core' ? 'bold' : 'normal';
          const primaryY = -(radius + primaryH / 2 + gap);
          s.position.set(0, primaryY, 0);
          group.add(s);

          // Secondary English bridge — smaller + muted, stacked just below the
          // primary. Layered-vocabulary discipline: Arabic carries the brand, the
          // English is a quiet comprehension aid (omitted where the name is already
          // English). Only renders when the node declares an `en` value.
          if (n.en) {
            const secH = primaryH * 0.62;
            const sub = new SpriteText(n.en);
            sub.color = '#8A93A3';
            sub.fontFace = 'Georgia, serif';
            sub.textHeight = secH;
            sub.position.set(0, primaryY - (primaryH / 2 + secH / 2 + 1.2), 0);
            group.add(sub);
          }
        }
        return group;
      })
      .linkColor((l) => (l.kind === 'composition' ? '#E6C66E' : 'rgba(155,175,210,0.95)'))
      .linkOpacity(0.85)
      .linkWidth((l) => (l.kind === 'composition' ? 1.1 : 0.55))
      .linkDirectionalParticles((l) => (l.kind === 'composition' ? 2 : 0))
      .linkDirectionalParticleWidth(1.4)
      .linkDirectionalParticleColor(() => '#E6C66E')
      .width(el.clientWidth)
      .height(el.clientHeight);

    // Gentle auto-orbit (OrbitControls) — disabled when the visitor prefers
    // reduced motion (accessibility; the graph stays fully drag-to-orbit).
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const controls = Graph.controls();
    controls.autoRotate = !reduceMotion;
    controls.autoRotateSpeed = 0.55;
    controls.enableDamping = true;
    controls.dampingFactor = 0.12;

    // Fit the graph to the frame once the force layout settles (and as a fallback).
    let fitted = false;
    Graph.onEngineStop(() => { if (!fitted) { Graph.zoomToFit(700, 55); fitted = true; } });
    setTimeout(() => Graph.zoomToFit(700, 55), 1600);

    Graph.onNodeClick((node) => {
      controls.autoRotate = false;
      if (node.kind === 'anon') {
        panel.innerHTML =
          '<p class="pg-fam">' + familyLabel(node.family) + '</p>' +
          '<h3>A private capability</h3>' +
          '<p>A real substrate in this family, held private. The map shows the framework’s true breadth; the internals stay internal.</p>';
      } else if (node.desc) {
        const fam = node.kind === 'named' ? '<p class="pg-fam">' + familyLabel(node.family) + '</p>' : '';
        const en = node.en ? ' <span class="pg-en">· ' + node.en + '</span>' : '';
        // Doc-link slot — dormant until a node declares a `doc` slug (Slice C).
        const more = node.doc ? '<p class="pg-more"><a href="' + node.doc + '">Read more →</a></p>' : '';
        panel.innerHTML = fam + '<h3>' + node.label + en + '</h3><p>' + node.desc + '</p>' + more;
      }
      // Fly the camera to the node.
      const d = 90;
      const r = 1 + d / Math.hypot(node.x || 1, node.y || 1, node.z || 1);
      Graph.cameraPosition({ x: (node.x || 0) * r, y: (node.y || 0) * r, z: (node.z || 0) * r }, node, 1400);
    });

    Graph.onBackgroundClick(() => {
      panel.innerHTML = defaultHTML;
      controls.autoRotate = !reduceMotion;
      Graph.zoomToFit(600, 55);
    });

    // Resize with container.
    const ro = new ResizeObserver(() => Graph.width(el.clientWidth).height(el.clientHeight));
    ro.observe(el);
  }
</script>
